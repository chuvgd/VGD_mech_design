<?xml version="1.0" encoding="UTF-16" standalone="no"?>
<mstns:materials xmlns:mstns="http://www.solidworks.com/sldmaterials" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sldcolorswatch="http://www.solidworks.com/sldcolorswatch" version="2008.03">
	<classification name="VGD_碳纤维板">
		<material name="碳纤维板-准各向同性(初算用)" matid="1">
			<physicalproperties>
				<DENS displayname="质量密度" value="1575"/>
				<EX displayname="弹性模量" value="55000000000"/>
				<NUXY displayname="泊松比" value="0.05"/>
				<GXY displayname="剪切模量" value="26190476190"/>
				<SIGXT displayname="抗拉强度" value="650000000"/>
			</physicalproperties>
		</material>
	</classification>
	<classification name="VGD_玻璃纤维板">
		<material name="黑色玻璃纤维板(G10/FR4,估计值)" matid="10">
			<shaders>
				<pwshader2 name="glass fiber" isNewShader="1" path="\glass\textured\glass fiber.p2m"/>
				<cgshader2 name="GlassFibre" ignorescolor="false"/>
				<swtexture path="images\textures\fibers\glassfiber.jpg"/>
			</shaders>
			<swatchcolor RGB="1a1a1a">
				<sldcolorswatch:Optical Ambient="1.000000" Transparency="0.000000" Diffuse="1.000000" Specularity="1.000000" Shininess="0.310000" Emission="0.000000"/>
			</swatchcolor>
			<xhatch name="ISO (钢)" angle="0.0" scale="1.0"/>
			<physicalproperties>
				<DENS displayname="质量密度" value="1800"/>
				<EX displayname="弹性模量" value="22000000000"/>
				<NUXY displayname="泊松比" value="0.13"/>
				<SIGXT displayname="抗拉强度" value="310000000"/>
			</physicalproperties>
		</material>
	</classification>
